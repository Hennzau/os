#!/bin/bash
# elvos-wg-enroll [--manual] [--name NAME] CONFIG
#
# Turn a wg-quick config - what a WireGuard provider hands out - into a
# systemd-networkd tunnel. The private key goes into an encrypted credential
# (sealed to the TPM where there is one), not into a file in /etc. DNS is
# left as it is: the config's DNS= line is ignored.
#
# Enrol as many as you like: each gets its own interface (wg-NAME), routing
# table and firewall mark. Which one carries your traffic is not decided
# here - elvos-vpn-watch measures them all and gives the catch-all routing
# rule to the fastest (`vpn status`, `vpn use NAME` to pin one).
#
#   --name NAME  what to call it (default: the config's file name)
#   --manual     do not bring it up at boot; `networkctl up wg-NAME` does
#   --root DIR   write under DIR instead of /, start nothing and skip the
#                credential - for testing this script, nothing else
#
# Run as root. Enrolling the same name again replaces that tunnel.
set -eu -o pipefail

# The first tunnel gets these, the next ones the values after them.
table_base=51820
mark_base=0xca6c

config="" activation=up name="" root=""

while [[ $# -gt 0 ]]; do
    case $1 in
    --manual)
        activation=manual
        shift
        ;;
    --name)
        name=${2-}
        shift 2
        ;;
    --root)
        root=${2-}
        shift 2
        ;;
    -h | --help)
        sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    -*)
        echo "${0##*/}: unknown option: $1" >&2
        exit 2
        ;;
    *)
        config=$1
        shift
        ;;
    esac
done

die() {
    echo "${0##*/}: $*" >&2
    exit 1
}

[[ -n $config ]] || {
    echo "${0##*/}: need a wg-quick config file" >&2
    exit 2
}
[[ -r $config ]] || die "cannot read $config"
[[ -n $root || $EUID -eq 0 ]] || die "must run as root"

# The interface is wg-NAME, and an interface name is 15 characters at most.
[[ -n $name ]] || {
    name=${config##*/}
    name=${name%.conf}
}
name=${name//[^A-Za-z0-9_-]/-}
[[ ${#name} -le 12 ]] || die "name '$name' is longer than 12 characters"
iface="wg-$name"
netdev="50-$iface"

# section.Key=value, one per line, for every non-empty setting.
parse() {
    awk -F= '
                /^[[:space:]]*[#;]/ { next }
                /^[[:space:]]*\[/   { gsub(/[][[:space:]]/, "", $0); section = $0; next }
                NF < 2              { next }
                {
                        key = $1; sub(/[[:space:]]+$/, "", key); gsub(/^[[:space:]]+/, "", key)
                        val = substr($0, index($0, "=") + 1)
                        gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
                        if (val != "") print section "." key "=" val
                }
        ' "$1"
}

get() { parse "$config" | awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }'; }

private_key=$(get Interface.PrivateKey)
addresses=$(get Interface.Address)
peer_key=$(get Peer.PublicKey)
endpoint=$(get Peer.Endpoint)
allowed_ips=$(get Peer.AllowedIPs)
keepalive=$(get Peer.PersistentKeepalive)

for v in private_key addresses peer_key endpoint allowed_ips; do
    [[ -n ${!v} ]] || die "$config has no ${v//_/ }"
done
: "${keepalive:=25}"

# Before the umask below: on a fresh /etc these do not exist yet, and a
# network directory made 0700 is one networkd - not root - cannot read.
install -d -m 0755 "${root}/etc/systemd" "${root}/etc/systemd/network"
install -d -m 0700 "${root}/etc/credstore.encrypted"

# wg0 from the single-tunnel version of this script: its own catch-all rule
# would outrank whatever elvos-vpn-watch chooses.
if [[ -e "${root}/etc/systemd/network/50-wg0.netdev" ]]; then
    rm -f "${root}/etc/systemd/network/50-wg0.netdev" "${root}/etc/systemd/network/50-wg0.network" \
        "${root}/etc/credstore.encrypted/network.wireguard.private.50-wg0"
    echo "Removed the old single-tunnel wg0; enrol its config again to keep it."
fi

# The lowest table and mark no other tunnel is using: they pair up, so a
# tunnel's own packets (marked) never re-enter its own table.
index=0
while grep -qs "^RouteTable=$((table_base + index))$" "${root}"/etc/systemd/network/50-wg-*.netdev; do
    if [[ -e "${root}/etc/systemd/network/${netdev}.netdev" ]] &&
        grep -qs "^RouteTable=$((table_base + index))$" "${root}/etc/systemd/network/${netdev}.netdev"; then
        break # this tunnel's own, which is about to be rewritten
    fi
    index=$((index + 1))
done
table=$((table_base + index))
mark=$(printf '0x%x' $((mark_base + index)))

umask 077
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
printf '%s' "$private_key" >"$tmp/private"

# Sealed to the TPM where there is one, to the host key otherwise. Every
# key systemd-creds can use needs root, so a test root gets a placeholder.
credential="${root}/etc/credstore.encrypted/network.wireguard.private.${netdev}"
if [[ -n $root ]]; then
    echo "test root: not encrypting the key" >&2
    : >"$credential"
else
    systemd-creds encrypt --name="network.wireguard.private.${netdev}" \
        --with-key=auto "$tmp/private" "$credential"
fi

umask 022

# No PrivateKey=: networkd takes it from the credential above.
cat >"${root}/etc/systemd/network/${netdev}.netdev" <<EOF
[NetDev]
Name=${iface}
Kind=wireguard
Description=WireGuard VPN ${name}

[WireGuard]
FirewallMark=${mark}

[WireGuardPeer]
PublicKey=${peer_key}
Endpoint=${endpoint}
AllowedIPs=${allowed_ips}
PersistentKeepalive=${keepalive}
RouteTable=${table}
EOF

# The peer's routes live in the tunnel's own table. The rules here keep
# private networks and anything more specific than a default route on the
# main table, so the LAN stays reachable; the rule that sends everything
# else into a tunnel is elvos-vpn-watch's, which is how it switches.
{
    printf '[Match]\nName=%s\n\n[Link]\nActivationPolicy=%s\n\n[Network]\n' "$iface" "$activation"
    printf '%s' "$addresses" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;/^$/d;s/^/Address=/'
    printf '\n'
    cat <<'EOF'

[RoutingPolicyRule]
To=10.0.0.0/8
Table=main
Priority=32763

[RoutingPolicyRule]
To=172.16.0.0/12
Table=main
Priority=32763

[RoutingPolicyRule]
To=192.168.0.0/16
Table=main
Priority=32763

[RoutingPolicyRule]
Table=main
SuppressPrefixLength=0
Priority=32764
Family=both
EOF
} >"${root}/etc/systemd/network/${netdev}.network"

# A restart, not a reload: networkd imports its credentials when it starts.
if [[ -z $root ]]; then
    systemctl restart systemd-networkd
    # Unconditionally: the unit is skipped at boot while no tunnel exists
    # (ConditionPathExistsGlob), and `systemctl is-enabled` calls it
    # "disabled" anyway - this image enables units with a .wants symlink in
    # /usr, which systemd honours but does not count as enabled.
    systemctl restart elvos-vpn-watch.service || true
fi

enrolled=("${root}"/etc/systemd/network/50-wg-*.netdev)
cat <<MSG
Enrolled from: ${config}
  name       : ${name}  (interface ${iface}, table ${table}, mark ${mark})
  endpoint   : ${endpoint}
  addresses  : ${addresses}
  connect    : $([[ $activation == up ]] && echo "at every boot" || echo "by hand (--manual)")

${#enrolled[@]} tunnel(s) enrolled. The fastest carries your traffic: vpn status
Pin one: vpn use ${name}   Back to automatic: vpn auto

${config} still holds the private key - delete it: shred -u ${config}
MSG
