#!/usr/bin/env python3
"""Manage 802.1X (WPA-Enterprise) wifi networks for iwd.

iwd keeps one file per network in /var/lib/iwd, named after the SSID with an
.8021x suffix, and picks new or changed files up on its own. This writes those
files - and the CA certificate beside them - so an enterprise network is one
command instead of a hand-edited file.

    import FILE --identity ID     configure from an eap-config profile
    add SSID --identity ID ...    configure by hand
    list                          show configured 802.1X networks
    remove SSID                   delete a network and its certificate

The eap-config format is what eduroam CAT and geteduroam publish per
institution: it carries the EAP method, the CA, and the RADIUS server name, so
the only thing left to type is your login and password.

Writes to /var/lib/iwd, so it needs root.
"""

import argparse
import base64
import getpass
import json
import os
import re
import sys
import textwrap
import xml.etree.ElementTree as ET
from pathlib import Path

EAP_TLS, EAP_TTLS, EAP_PEAP, EAP_GTC, EAP_MSCHAPV2 = 13, 21, 25, 6, 26

# eap-config inner methods -> iwd's Phase2-Method values.
TTLS_NON_EAP = {1: "Tunneled-PAP", 2: "Tunneled-MSCHAP", 3: "Tunneled-MSCHAPv2"}
INNER_EAP = {EAP_MSCHAPV2: "MSCHAPV2", EAP_GTC: "GTC"}


def die(msg):
    sys.exit(f"{Path(sys.argv[0]).name}: {msg}")


def iwd_name(ssid):
    """iwd's file name for an SSID: literal if it is plain, =hex otherwise."""
    if re.fullmatch(r"[A-Za-z0-9_-]+", ssid):
        return ssid
    return "=" + ssid.encode().hex()


def ssid_of(name):
    return bytes.fromhex(name[1:]).decode(errors="replace") if name.startswith("=") else name


def pem(der_blobs):
    out = []
    for der in der_blobs:
        body = "\n".join(textwrap.wrap(base64.b64encode(der).decode(), 64))
        out.append(f"-----BEGIN CERTIFICATE-----\n{body}\n-----END CERTIFICATE-----\n")
    return "".join(out)


def read_ca(path):
    """A CA file as PEM, whether it was handed over as PEM or DER."""
    data = Path(path).read_bytes()
    if b"-----BEGIN CERTIFICATE-----" in data:
        return data.decode()
    return pem([data])


def domain_mask(servers):
    # eap-config ServerIDs match the name itself or anything under it; iwd's
    # mask matches whole labels, so spell out both forms.
    parts = []
    for s in servers:
        s = s.strip().lstrip("*.")
        parts += [s, f"*.{s}"]
    return ";".join(dict.fromkeys(parts))


def write_network(root, ssid, method, inner, identity, anonymous, password, ca_pem, servers, force):
    base = root / "var/lib/iwd"
    name = iwd_name(ssid)
    conf, ca = base / f"{name}.8021x", base / f"{name}-ca.pem"

    if conf.exists() and not force:
        die(f"{ssid} is already configured ({conf}); pass --force to replace it")

    kind = "TTLS" if method == EAP_TTLS else "PEAP"
    body = [
        "[Security]",
        f"EAP-Method={kind}",
        f"EAP-Identity={anonymous}",
        f"EAP-{kind}-CACert={Path('/var/lib/iwd') / ca.name}",
        f"EAP-{kind}-ServerDomainMask={domain_mask(servers)}",
        f"EAP-{kind}-Phase2-Method={inner}",
        f"EAP-{kind}-Phase2-Identity={identity}",
        f"EAP-{kind}-Phase2-Password={password}",
        "",
        "[Settings]",
        "AutoConnect=true",
        "",
    ]

    base.mkdir(parents=True, exist_ok=True)
    old = os.umask(0o077)
    try:
        for path, text in ((ca, ca_pem), (conf, "\n".join(body))):
            tmp = path.with_name(path.name + ".new")
            tmp.write_text(text)
            tmp.replace(path)
    finally:
        os.umask(old)

    print(f"configured {ssid}: {kind} / {inner}, server {', '.join(servers)}")
    print(f"  {conf}")


def ask_password(args):
    if args.password_stdin:
        pw = sys.stdin.readline().rstrip("\n")
    else:
        pw = getpass.getpass(f"password for {args.identity}: ")
    if not pw:
        die("empty password")
    return pw


def anonymous_for(args, realm):
    if args.anonymous:
        return args.anonymous
    realm = args.identity.partition("@")[2] or realm
    return f"anonymous@{realm}" if realm else "anonymous"


def pick_method(provider):
    """First method we can drive, in the provider's own order of preference."""
    for m in provider.iterfind("AuthenticationMethods/AuthenticationMethod"):
        outer = int(m.findtext("EAPMethod/Type", "0"))
        if outer not in (EAP_TTLS, EAP_PEAP):
            continue

        non_eap = m.findtext("InnerAuthenticationMethod/NonEAPAuthMethod/Type")
        inner_eap = m.findtext("InnerAuthenticationMethod/EAPMethod/Type")

        if outer == EAP_TTLS and non_eap:
            inner = TTLS_NON_EAP.get(int(non_eap))
        elif inner_eap:
            inner = INNER_EAP.get(int(inner_eap))
        else:
            inner = None
        if not inner:
            continue

        cas = [base64.b64decode("".join(c.text.split()))
               for c in m.iterfind("ServerSideCredential/CA") if c.text]
        servers = [s.text.strip() for s in m.iterfind("ServerSideCredential/ServerID") if s.text]
        outer_id = m.findtext("ClientSideCredential/OuterIdentity")
        return outer, inner, cas, servers, outer_id
    return None


def cmd_import(args):
    try:
        tree = ET.parse(args.file)
    except ET.ParseError as e:
        die(f"{args.file}: not an eap-config file ({e})")

    provider = tree.getroot().find("EAPIdentityProvider")
    if provider is None:
        die(f"{args.file}: no EAPIdentityProvider in it")

    chosen = pick_method(provider)
    if chosen is None:
        types = [m.findtext("EAPMethod/Type") for m in provider.iterfind("AuthenticationMethods/AuthenticationMethod")]
        die(f"no TTLS or PEAP method with a supported inner method (offered EAP types: {', '.join(types)}); "
            "EAP-TLS needs a client certificate and is not handled here")
    outer, inner, cas, servers, outer_id = chosen

    if not cas:
        die("the profile ships no CA certificate - refusing to connect without verifying the server")
    if not servers:
        die("the profile names no RADIUS server - refusing to connect without checking its name")

    ssids = args.ssid or [s.text for s in provider.iterfind("CredentialApplicability/IEEE80211/SSID") if s.text]
    if not ssids:
        die("the profile names no SSID; pass --ssid")

    realm = provider.get("ID", "")
    anonymous = args.anonymous or outer_id or anonymous_for(args, realm)
    password = ask_password(args)

    for ssid in ssids:
        write_network(Path(args.root), ssid, outer, inner, args.identity, anonymous,
                      password, pem(cas), servers, args.force)


def cmd_add(args):
    method = {"TTLS": EAP_TTLS, "PEAP": EAP_PEAP}[args.method.upper()]
    inner = args.inner or ("Tunneled-PAP" if method == EAP_TTLS else "MSCHAPV2")
    ca_pem = read_ca(args.ca)
    password = ask_password(args)
    write_network(Path(args.root), args.ssid, method, inner, args.identity,
                  anonymous_for(args, ""), password, ca_pem, [args.server], args.force)


def cmd_list(args):
    base = Path(args.root) / "var/lib/iwd"
    for conf in sorted(base.glob("*.8021x")):
        fields = dict(line.split("=", 1) for line in conf.read_text().splitlines() if "=" in line)
        method = fields.get("EAP-Method", "?")
        print(json.dumps({
            "ssid": ssid_of(conf.stem),
            "method": method,
            "inner": fields.get(f"EAP-{method}-Phase2-Method", ""),
            "identity": fields.get(f"EAP-{method}-Phase2-Identity", ""),
            "server": fields.get(f"EAP-{method}-ServerDomainMask", ""),
        }))


def cmd_remove(args):
    base = Path(args.root) / "var/lib/iwd"
    name = iwd_name(args.ssid)
    conf = base / f"{name}.8021x"
    if not conf.exists():
        die(f"{args.ssid} is not configured")
    conf.unlink()
    (base / f"{name}-ca.pem").unlink(missing_ok=True)
    print(f"removed {args.ssid}")


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--root", default="/", help="prefix for /var/lib/iwd (for testing)")
    sub = p.add_subparsers(dest="cmd", required=True)

    def secret_opts(sp):
        sp.add_argument("--identity", required=True, help="your login, usually user@realm")
        sp.add_argument("--anonymous", help="outer identity (default: anonymous@realm)")
        sp.add_argument("--password-stdin", action="store_true", help="read the password from stdin")
        sp.add_argument("--force", action="store_true", help="replace an existing network")

    i = sub.add_parser("import"); i.add_argument("file")
    i.add_argument("--ssid", action="append", help="only these SSIDs (default: all in the profile)")
    secret_opts(i); i.set_defaults(fn=cmd_import)

    a = sub.add_parser("add"); a.add_argument("ssid")
    a.add_argument("--ca", required=True, help="CA certificate, PEM or DER")
    a.add_argument("--server", required=True, help="RADIUS server name, e.g. radius.univ.fr")
    a.add_argument("--method", default="TTLS", choices=["TTLS", "PEAP", "ttls", "peap"])
    a.add_argument("--inner", help="Tunneled-PAP, Tunneled-MSCHAPv2 (TTLS) or MSCHAPV2 (PEAP)")
    secret_opts(a); a.set_defaults(fn=cmd_add)

    l = sub.add_parser("list"); l.set_defaults(fn=cmd_list)
    r = sub.add_parser("remove"); r.add_argument("ssid"); r.set_defaults(fn=cmd_remove)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
