<?xml version="1.0"?>
<!-- LibreOffice defaults for elvOS.

     LibreOfficeTheme=1 makes LibreOffice push its own colours into GTK as a
     stylesheet, including "tooltip { background-color }" and "tooltip * {
     color }". Our gtk.css also styles the tooltip node, at GTK's user
     priority, so the background came from us and the text from LibreOffice -
     dark on dark, unreadable. Turning the theme off lets LibreOffice follow
     the GTK colours like every other toolkit app.

     ApplicationAppearance=0 is "Automatic", i.e. follow the system too.

     CalcCellFocus is Calc's colour for the current cell's frame and the
     highlight of its row and column headers. It has no value in the default
     scheme (COLOR_SCHEME_LIBREOFFICE_AUTOMATIC), so LibreOffice derives one,
     and with our GTK colours it came out #fafafa - the palette's bg.editor -
     a white frame on white cells, and selected headers lighter than the rest.
     No GTK colour steers it: giving each named colour a test value changed
     nothing. So it is set here, to the palette's accent.primary (#5c78e2,
     as LibreOffice's int: 0x5c78e2 = 6060258).

     These are defaults: a user profile that already set them keeps its value. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:oor="http://openoffice.org/2001/registry"><dependency file="main"/><oor:component-data oor:name="Common" oor:package="org.openoffice.Office"><node oor:name="Appearance"><prop oor:name="LibreOfficeTheme"><value>0</value></prop><prop oor:name="ApplicationAppearance"><value>0</value></prop></node></oor:component-data><oor:component-data oor:name="UI" oor:package="org.openoffice.Office"><node oor:name="ColorScheme"><node oor:name="ColorSchemes"><node oor:name="COLOR_SCHEME_LIBREOFFICE_AUTOMATIC" oor:op="fuse"><node oor:name="CalcCellFocus"><prop oor:name="Color"><value>6060258</value></prop></node></node></node></node></oor:component-data></oor:data>
