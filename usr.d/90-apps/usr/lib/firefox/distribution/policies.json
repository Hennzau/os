    "SearchEngines": {
      "Default": "DuckDuckGo Safe",
      "Remove": [
        "DuckDuckGo",
        "Google",
        "Bing",
        "eBay",
        "Perplexity",
        "Reddit",
        "YouTube"
      ],
      "Add": [
        {
          "Name": "DuckDuckGo Safe",
          "URLTemplate": "https://safe.duckduckgo.com/?q={searchTerms}",
          "SuggestURLTemplate": "https://safe.duckduckgo.com/ac/?q={searchTerms}&type=list",
          "Method": "GET",
          "Alias": "@ddg",
          "Description": "DuckDuckGo (safe-search host, matches AdGuard Family DNS)",
