        },
        {
          "Name": "Arch Packages",
          "URLTemplate": "https://archlinux.org/packages/?q={searchTerms}",
          "Method": "GET",
          "Alias": "@pkg",
          "Description": "Arch Linux official repositories",
          "IconURL": "https://archlinux.org/static/favicon.51c13517c44c.png"
        },
        {
          "Name": "Arch Wiki",
          "URLTemplate": "https://wiki.archlinux.org/index.php?search={searchTerms}",
          "Method": "GET",
          "Alias": "@wiki",
          "Description": "ArchWiki",
          "IconURL": "https://wiki.archlinux.org/favicon.ico"
        },
        {
          "Name": "AUR",
          "URLTemplate": "https://aur.archlinux.org/packages?K={searchTerms}",
          "Method": "GET",
          "Alias": "@aur",
          "Description": "Arch User Repository",
          "IconURL": "https://aur.archlinux.org/static/favicon.ico"
        },
        {
          "Name": "crates.io",
          "URLTemplate": "https://crates.io/search?q={searchTerms}",
          "Method": "GET",
          "Alias": "@crates",
          "Description": "Rust package registry",
          "IconURL": "https://crates.io/favicon.ico"
        },
        {
          "Name": "docs.rs",
          "URLTemplate": "https://docs.rs/releases/search?query={searchTerms}",
          "Method": "GET",
          "Alias": "@docs",
          "Description": "Rust crate documentation",
