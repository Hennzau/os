#!/bin/bash
set -eu

if [[ -z ${XDG_RUNTIME_DIR-} ]]; then
        echo "elvos-login: XDG_RUNTIME_DIR unset - pam_systemd registered no" \
             "logind session, so niri will not get a seat." >&2
        echo "elvos-login: session=${XDG_SESSION_ID-none} vt=${XDG_VTNR-none}" \
             "seat=${XDG_SEAT-none} user=$(id -un)" >&2
fi

runtime=${XDG_RUNTIME_DIR:-/tmp}
export XDG_CACHE_HOME="$runtime/elvos-greeter/cache"
export XDG_STATE_HOME="$runtime/elvos-greeter/state"
export XDG_DATA_HOME="$runtime/elvos-greeter/data"
export XDG_CONFIG_HOME="$runtime/elvos-greeter/config"
mkdir -p "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"

exec niri -c /usr/share/greetd/niri.kdl -- /usr/bin/elvos-greeter
