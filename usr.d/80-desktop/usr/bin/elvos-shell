#!/bin/bash
# The audio panel reads the default output and input from PipeWire's
# "default" metadata. At login the shell starts in the same second as
# PipeWire and WirePlumber; connected before WirePlumber had published the
# defaults, Quickshell never picked them up - the panel showed "-" for both
# and ignored clicks on a device. So wait, 5 s at most, for WirePlumber to
# have chosen a default output.
for _ in $(seq 50); do
    pw-metadata -n default 2>/dev/null | grep -q "default.audio.sink" && break
    sleep 0.1
done

exec quickshell -p /usr/share/quickshell/desktop/shell.qml "$@"
